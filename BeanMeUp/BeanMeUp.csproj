<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET Framework 4.8 ist in jedem Windows 10/11 enthalten: winzige EXE, keine Installation nötig. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>BeanMeUp</AssemblyName>
    <RootNamespace>BeanMeUp</RootNamespace>
    <!-- Programm-Icon "Dämmerung". Neu erzeugen: siehe README, Abschnitt "Programm-Icon neu erzeugen" -->
    <ApplicationIcon>BeanMeUp.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Angaben in den Dateieigenschaften der EXE (Rechtsklick > Eigenschaften > Details) -->
  <PropertyGroup>
    <Product>Bean me up</Product>
    <Title>Bean me up</Title>
    <AssemblyTitle>Bean me up</AssemblyTitle>
    <Description>Bean me up – hält deinen PC wach und schaltet Hell/Dunkel automatisch.</Description>
    <Authors>SiS</Authors>
    <Company>SiS</Company>
    <Copyright>© 2026 SiS</Copyright>
    <Version>2.2.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Drawing" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading" />
    <Using Include="System.Windows.Forms" />
  </ItemGroup>

  <!-- Dokumentation im Projektmappen-Explorer anzeigen -->
  <ItemGroup>
    <None Include="..\README.md" Link="README.md" />
  </ItemGroup>

</Project>
